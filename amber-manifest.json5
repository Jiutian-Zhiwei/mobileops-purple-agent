{
  manifest_version: "0.1.0",

  // 运行时：容器镜像 + 启动命令 + 环境变量 + 对外端口
  program: {
    image: "ghcr.io/jiutian-zhiwei/mobileops-purple-agent:latest",
    entrypoint: [
      "uv",
      "run",
      "src/server.py",
      "--host",
      "0.0.0.0",
      "--port",
      "9009",
    ],
    // 只引用确实需要的配置项。Amber 会对 env 做 ${config.X} 插值，
    // 而提交时空值的 secret 字段不会出现在 config 里 → 插值失败 → 容器启动即退出。
    env: {
      AGENT_LLM: "${config.agent_llm}",
      DEEPSEEK_API_KEY: "${config.deepseek_api_key}",
      LOG_LEVEL: "INFO",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9009 },
      ],
    },
  },

  // 部署方（AgentBeats）需要提供的配置项；密钥类字段标记 secret: true
  // 注意：只在下面声明的字段才会出现在提交表单里；声明了但留空会导致容器起不来。
  config_schema: {
    type: "object",
    properties: {
      agent_llm: { type: "string", default: "deepseek/deepseek-chat" },
      deepseek_api_key: { type: "string", secret: true, default: "" },
    },
    required: ["agent_llm"],
    additionalProperties: false,
  },

  // 场景会给 purple agent 绑一个 proxy（reviewer/回调用）；optional 表示不绑也能跑
  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  // 对外提供的能力
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
}
